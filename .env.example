# --- Environment model: development | demo | production (unknown/missing => production) ---
APP_ENV=development
# --- Database (Neon: use the POOLED connection string for serverless) ---
DATABASE_URL=postgres://user:password@localhost:5433/hambazi
# --- Secrets (generate: openssl rand -hex 32) ---
OTP_HMAC_SECRET=change-me-32-bytes-hex
SESSION_SECRET=change-me-32-bytes-hex
CRON_SECRET=change-me
# --- Public base URL ---
APP_URL=http://localhost:3000
# --- SMS (production requires a real provider) ---
SMS_PROVIDER=mock            # mock (dev/demo only) | kavenegar | melipayamak (future)
SMS_API_KEY=
SMS_SENDER=
# --- Payments ---
# simulated = fake payments for dev/demo ONLY. The server refuses to start in production with it.
PAYMENT_MODE=simulated       # disabled | simulated (dev/demo only) | sandbox | live
# --- Image uploads ---
# Vercel Blob read/write token (Vercel dashboard > Storage > Blob). Empty in local dev => images saved to public/uploads.
BLOB_READ_WRITE_TOKEN=
